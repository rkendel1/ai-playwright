{
  "name": "runora",
  "version": "1.0.14",
  "description": "Runora is an evidence-first browser testing platform that uses AI to understand what should be tested while Playwright executes and proves what actually happened.",
  "main": "dist/packages/core/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/packages/workspace && cp packages/workspace/ui.html dist/packages/workspace/ui.html && vite build --config vite.workspace.config.ts",
    "build:wasm": "tsc -p tsconfig.wasm.json",
    "test": "vitest run",
    "dev": "tsx packages/cli/index.ts",
    "web:dev": "vite",
    "web:build": "vite build",
    "packages:publish": "node scripts/publish-packages.mjs",
    "publish:packages": "npm run packages:publish",
    "prepack": "npm run build"
  },
  "workspaces": [
    "packages/create-runora"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rkendel1/ai-playwright.git"
  },
  "homepage": "https://github.com/rkendel1/ai-playwright#readme",
  "keywords": [
    "runora",
    "browser-testing",
    "playwright",
    "testing",
    "automation",
    "evidence"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@feltdb/core": "^0.10.0",
    "@mlc-ai/web-llm": "^0.2.85",
    "playwright": "^1.63.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "type": "module",
  "exports": {
    ".": "./dist/packages/core/index.js",
    "./workspace": "./dist/packages/workspace/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "runora": "dist/packages/cli/index.js",
    "ai-playwright": "dist/packages/cli/index.js",
    "aipw": "dist/packages/cli/index.js"
  }
}
