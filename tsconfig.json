{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist",
    "types": ["node"]
  },
  "include": ["packages/**/*.ts", "tests/**/*.ts", "apps/**/*.ts"],
  "exclude": ["packages/**/*-sketch.ts"]
}
